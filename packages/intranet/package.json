{
  "name": "@hydra-dsh/intranet",
  "version": "0.0.0",
  "description": "内网能力全家桶：Wiki 读写（写入过审批）+ GitLab 代码分析，一装齐",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangyue55/hydra-dsh-plugin.git",
