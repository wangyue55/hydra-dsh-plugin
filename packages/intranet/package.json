  },
  "devDependencies": {
    "@deepseek-ai/cordis-plugin-include": "^1.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.0",
    "js-yaml": "^4.2.0",
    "typescript": "^6.0.3"
