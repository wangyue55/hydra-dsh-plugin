{
  "name": "@hydra-dsh/plugin-intranet-wiki",
  "version": "0.0.0",
  "description": "内网 Wiki 工具：预算受控的页面读取 + 两步式回写，执行步经人工审批",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wangyue55/hydra-dsh-plugin.git",
    "directory": "packages/plugin-intranet-wiki"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "catalog": {
      "status": "stable",
      "platform": "all"
    }
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "build": "tsdown",
    "prepare": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-credentials": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-launch-environment": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.2"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/cordis-plugin-include": "^1.0.7",
    "@deepseek-ai/cordis-plugin-loader": "^1.0.3",
    "@deepseek-ai/dsh-credentials": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-credentials-local": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-launch-environment": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-llm": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-system-prompt": "^0.1.2-rc.1",
    "@deepseek-ai/dsh-tools": "^0.1.2-rc.1",
    "@types/node": "^22.19.0",
    "tsdown": "^0.22.2",
    "typescript": "^6.0.3"
  }
}
